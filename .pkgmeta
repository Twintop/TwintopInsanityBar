# BigWigs packager metadata for the MAINLINE flavor; .pkgmeta-forever and .pkgmeta-classic are the Forever and Classic counterparts.
# The packager reads the TOC at the repository root, so .github/workflows/release.yml copies the other flavor's
# TOC into place before running with -m .pkgmeta-<flavor>. CHANGELOG.md is generated from the flavor's
# News.lua by the workflow; it is read from the repository root and never shipped in the zip.
package-as: TwintopInsanityBar

enable-nolib-creation: no

manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

ignore:
    - Flavors/Forever
    - Flavors/Classic
    - CHANGELOG.md
    - build
    - dist
    - docs
    - memories
    - .github
    - .vscode
    - .VSCodeCounter
    - .patches
    - .luarc.json
    - .pkgmeta
    - .pkgmeta-forever
    - .pkgmeta-classic
    - TwintopInsanityBar.wowproj
    - TwintopInsanityBar.wowsln
